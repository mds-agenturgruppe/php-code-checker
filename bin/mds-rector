DEFAULT_CONFIG="--config ./vendor/mds-agenturgruppe/php-code-checker/rulesets/default/rector-default.php"

DRY_RUN="--dry-run"
for arg in "$@"; do
  # Option "--force-run"
  if [ "$arg" == "--force-run" ]; then
    DRY_RUN=''
    break
  fi
done

./vendor/bin/rector process $DEFAULT_CONFIG $DRY_RUN "$@"
